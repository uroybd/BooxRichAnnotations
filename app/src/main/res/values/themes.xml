<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- E-ink optimized theme -->
    <style name="Base.Theme.BooxRichAnnotation" parent="Theme.Material3.Light.NoActionBar">
        <!-- Pure white/black colors for e-ink -->
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        
        <item name="colorSecondary">#000000</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        
        <!-- Control colors -->
        <item name="colorControlNormal">#000000</item>
        <item name="colorControlActivated">#000000</item>
        <item name="colorControlHighlight">#000000</item>
        <item name="android:colorControlNormal">#000000</item>
        <item name="android:colorControlActivated">#000000</item>
        <item name="android:colorControlHighlight">#000000</item>
        
        <!-- Icon tint -->
        <item name="android:tint">#000000</item>
        <item name="tint">#000000</item>
        
        <!-- Progress bar -->
        <item name="android:colorAccent">#000000</item>
        
        <!-- Disable all animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
        
        <!-- Material motion disabled -->
        <item name="motionDurationShort1">0</item>
        <item name="motionDurationShort2">0</item>
        <item name="motionDurationMedium1">0</item>
        <item name="motionDurationMedium2">0</item>
        <item name="motionDurationLong1">0</item>
        <item name="motionDurationLong2">0</item>
        
        <!-- Text appearance -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColorHint">#666666</item>
        
        <!-- Dialog theme -->
        <item name="alertDialogTheme">@style/Theme.BooxRichAnnotation.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.BooxRichAnnotation.Dialog</item>
        
        <!-- Popup menu theme -->
        <item name="popupMenuStyle">@style/Widget.BooxRichAnnotation.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.BooxRichAnnotation.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.BooxRichAnnotation.PopupMenu</item>
    </style>

    <style name="Theme.BooxRichAnnotation" parent="Base.Theme.BooxRichAnnotation" />
    
    <!-- Custom dialog theme for e-ink -->
    <style name="Theme.BooxRichAnnotation.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@drawable/bg_dialog</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        
        <!-- Text colors -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        
        <!-- Button styles -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.BooxRichAnnotation.Button.TextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.BooxRichAnnotation.Button.TextButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.BooxRichAnnotation.Button.TextButton</item>
        
        <!-- Single choice styles -->
        <item name="android:textColorAlertDialogListItem">#000000</item>
        <item name="android:checkedTextViewStyle">@style/Widget.BooxRichAnnotation.CheckedTextView</item>
    </style>
    
    <!-- Custom button style for dialogs -->
    <style name="Widget.BooxRichAnnotation.Button.TextButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#000000</item>
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <!-- Custom checked text view for single choice -->
    <style name="Widget.BooxRichAnnotation.CheckedTextView" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">#000000</item>
        <item name="android:checkMarkTint">#000000</item>
    </style>
    
    <!-- Custom popup menu style -->
    <style name="Widget.BooxRichAnnotation.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">0dp</item>
    </style>
</resources>