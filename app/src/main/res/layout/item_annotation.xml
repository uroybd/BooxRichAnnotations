<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeColor="#000000"
    app:strokeWidth="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Selection checkbox, style chip, page, chapter, timestamp: all one line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/annotation_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:buttonTint="#000000"
                android:contentDescription="Select annotation" />

            <TextView
                android:id="@+id/annotation_style_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Highlight" />

            <TextView
                android:id="@+id/annotation_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#000000"
                android:textSize="14sp"
                tools:text="Page 12" />

            <TextView
                android:id="@+id/annotation_chapter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="italic"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Chapter 3: The Turning Point" />

            <TextView
                android:id="@+id/annotation_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#000000"
                android:textSize="13sp"
                tools:text="May 1, 2024 10:32" />

        </LinearLayout>

        <!-- Highlighted quote, with a left accent bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#000000" />

            <TextView
                android:id="@+id/annotation_quote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="#000000"
                android:textSize="17sp"
                tools:text="This is the highlighted selection text from the book, which can span multiple lines." />

        </LinearLayout>

        <!-- Note (optional) -->
        <View
            android:id="@+id/annotation_note_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="#000000"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/annotation_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Note: This connects to the theme discussed in chapter 1."
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
