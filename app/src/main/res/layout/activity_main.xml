<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name"
        app:titleTextColor="#000000"
        style="?attr/borderlessButtonStyle" />

    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <LinearLayout
        android:id="@+id/main_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/toolbar_divider">

        <TextView
            android:id="@+id/tab_books"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_pill_selected"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:text="Books"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tab_annotations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_pill_unselected"
            android:gravity="center"
            android:textColor="#000000"
            android:textSize="18sp"
            android:text="Annotations"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <View
        android:id="@+id/tabs_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/main_tabs" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search"
        android:elevation="0dp"
        app:iconifiedByDefault="false"
        app:queryHint="Search books or authors..."
        app:queryBackground="@android:color/transparent"
        app:searchIcon="@android:drawable/ic_menu_search"
        app:closeIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toBottomOf="@id/tabs_divider" />

    <LinearLayout
        android:id="@+id/annotations_selection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/search_view"
        tools:visibility="visible">

        <CheckBox
            android:id="@+id/annotations_select_all_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Select All"
            android:textColor="#000000"
            android:textSize="16sp"
            android:buttonTint="#000000"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/annotations_selection_count_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="#000000"
            android:textSize="16sp"
            tools:text="3 selected" />

        <ImageButton
            android:id="@+id/btn_annotations_export_menu_selected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_more_vert"
            android:background="@drawable/bg_button"
            android:contentDescription="More save options"
            android:tooltipText="Save as..."
            android:scaleType="centerInside"
            android:padding="8dp"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/btn_annotations_share_selected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_share"
            android:background="@drawable/bg_button"
            android:contentDescription="Share selected annotations"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btn_annotations_save_selected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_save"
            android:background="@drawable/bg_button"
            android:contentDescription="Save selected annotations"
            android:scaleType="centerInside"
            android:padding="8dp" />

    </LinearLayout>

    <View
        android:id="@+id/annotations_selection_toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/annotations_selection_toolbar"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/books_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_view"
        tools:listitem="@layout/item_book" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/annotations_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/annotations_selection_toolbar_divider"
        tools:listitem="@layout/item_annotation_group_header" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No books found"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
