<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/book_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".BookDetailActivity">

    <LinearLayout
        android:id="@+id/book_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/book_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="The Great Gatsby" />

            <TextView
                android:id="@+id/book_detail_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="F. Scott Fitzgerald" />

        </LinearLayout>

        <TextView
            android:id="@+id/book_detail_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="42 annotations" />

    </LinearLayout>

    <View
        android:id="@+id/book_header_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/book_header" />

    <LinearLayout
        android:id="@+id/selection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/book_header_divider">

        <CheckBox
            android:id="@+id/select_all_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Select All"
            android:textColor="#000000"
            android:textSize="16sp"
            android:buttonTint="#000000"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/selection_count_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="#000000"
            android:textSize="16sp"
            tools:text="3 selected" />

        <ImageButton
            android:id="@+id/btn_share_selected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_share"
            android:background="@drawable/bg_button"
            android:contentDescription="Share selected annotations"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btn_save_selected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_save"
            android:background="@drawable/bg_button"
            android:contentDescription="Save selected annotations"
            android:scaleType="centerInside"
            android:padding="8dp" />

    </LinearLayout>

    <View
        android:id="@+id/selection_toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/selection_toolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/annotations_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/selection_toolbar_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_annotation" />

    <TextView
        android:id="@+id/annotations_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No annotations found for this book"
        android:textColor="#000000"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/selection_toolbar_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>
